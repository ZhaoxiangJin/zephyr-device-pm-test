 *
 * DAC wiring for the device-PM test on FRDM-MCXA346.
 *
 * DAC0_OUT and the board console's LPUART2_TXD share P2_2.
 * This register-only test leaves the pad with the console.
 */

/ {
	zephyr,user {
		dac = <&dac0>;
		dac-channel-id = <0>;
		dac-resolution = <12>;
		dac-console-shared-pad;
	};
};

&dac0 {
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-names;
};
